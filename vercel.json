{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "game/**" } },
  "crons": [{ "path": "/api/cron/door-rush-prize", "schedule": "10 5 * * 1" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/frats", "destination": "/frats.html" },
    { "source": "/sororities", "destination": "/sororities.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/about", "destination": "/about.html" }
  ]
}
