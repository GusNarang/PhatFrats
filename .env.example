# Copy this file to .env and fill in your Neon connection string.
# Never commit .env or paste its contents anywhere public.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full
PORT=3000

# Sends confirmation codes. Without SMTP_HOST, local runs print the code to the
# terminal instead, and a production site can't send codes at all.
# For Gmail, SMTP_PASS is a Google "app password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
# Optional. Defaults to SMTP_USER.
EMAIL_FROM=
