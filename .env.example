# Copy this file to .env and fill in your Neon connection string.
# Never commit .env or paste its contents anywhere public.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full
PORT=3000

# Sends confirmation codes. Without SMTP_HOST, local runs print the code to the
# terminal instead, and a production site can't send codes at all.
# For Gmail, SMTP_PASS is a Google "app password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
# Optional. Defaults to SMTP_USER.
EMAIL_FROM=

# PhatBot, the AI chat. Without a key, the chat button stays hidden.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5 at low effort.
PHATBOT_MODEL=
PHATBOT_EFFORT=

# Stripe checkout for Full Access. Leave empty to keep checkout off.
# Secret key from the Stripe dashboard (Developers > API keys). Use sk_test_... to try it, sk_live_... to take real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://phat-frats.vercel.app/api/stripe/webhook (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
